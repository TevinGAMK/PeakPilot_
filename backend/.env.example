# Copy to backend/.env. Every value is optional.

# Live Gemini interpretation. Without a key the app uses the deterministic fallback
# interpreter and labels it as such in the UI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Reasoning depth for models that support it (low keeps responses around 1-3s). Blank = model default.
GEMINI_THINKING_LEVEL=low
# auto = use Gemini when a key is present; fallback = always use the rule-based interpreter
PERKPILOT_AI_MODE=auto

# MongoDB persistence. Leave empty to use the local JSON-file fallback (backend/data/demo_state.json).
MONGODB_URI=
MONGODB_DB=perkpilot

# demo (default) = seeded StrideLab store, simulated clock/payments/refunds/shipping.
# live = real clock, no seeding, demo + simulated-effect routes removed, MongoDB required (no file fallback).
PERKPILOT_MODE=demo
# Bearer token for the order audit (/api/admin/*: record hashes, event log, verification checks) in every mode;
# without it the audit stays closed. In live mode it also protects /api/merchant/* and /api/eval/*.
PERKPILOT_ADMIN_TOKEN=
# live only: comma-separated CORS origins.
PERKPILOT_ALLOWED_ORIGINS=

# Read-only Shopify catalog sync: `python -m app.shopify sync [--only-shopify]` (scopes: read_products, read_inventory).
SHOPIFY_SHOP=your-store.myshopify.com
# Dev Dashboard app credentials (client credentials grant)...
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
# ...or an existing Admin API access token (shpat_...) from a legacy custom app. Takes precedence if set.
SHOPIFY_ADMIN_TOKEN=
SHOPIFY_API_VERSION=2026-10
SHOPIFY_SIZE_OPTION=Size
SHOPIFY_COLOR_OPTION=Color
# Live store data on the merchant dashboard: Shopify sends webhooks to <this URL>/api/shopify/webhooks.
# Must be the app's public HTTPS address (a deployment, or an ngrok tunnel to port 3000). Orders need the read_orders scope.
PERKPILOT_PUBLIC_URL=
